# ---------- Backend ----------
# JDBC URL. Local: jdbc:postgresql://localhost:5432/invictus
# Neon:  jdbc:postgresql://<host>/<db>?sslmode=require   (must start with jdbc:, not postgresql://)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=

# Admin account, created/updated at startup from these values
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gemini (server-side only, never exposed to the frontend)
GEMINI_API_KEY=
# Required: the exact Gemini model id to call. Nothing in the code defaults to a model.
GEMINI_MODEL=
# Optional: cap on output tokens per AI call. Leave unset/0 to use the model's own limit.
# GEMINI_MAX_OUTPUT_TOKENS=0

# Max AI generations per team in Round 2 (optional)
# ROUND2_MAX_GENERATIONS=40

# Comma-separated list of allowed browser origins (your Vercel URL)
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# ---------- Frontend (set in Vercel, or frontend/.env) ----------
# VITE_API_URL=https://your-backend.onrender.com
